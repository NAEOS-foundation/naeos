# NAEOS Control Plane - staging environment template
# Copy to .env.staging locally. Never commit real credentials.
NAEOS_CONTROLPLANE_ENVIRONMENT=staging

# Set this to a valid, provisioned least-privilege login role.
# Keep password out of repository; URL-encode special characters.
NAEOS_CONTROLPLANE_DATABASE_URL=postgresql://<DB_LOGIN>:<DB_PASSWORD>@db.<SUPABASE_PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# Supabase Auth trust configuration
NAEOS_CONTROLPLANE_ISSUER=https://<SUPABASE_PROJECT_REF>.supabase.co/auth/v1
NAEOS_CONTROLPLANE_AUDIENCE=authenticated
NAEOS_CONTROLPLANE_JWKS_URL=https://<SUPABASE_PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json

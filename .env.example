# Product Hunt app credentials — copy to .env (gitignored) and fill in.
# Register the app at https://www.producthunt.com/v2/oauth/applications
NAEOS_PH_REDIRECT_URI=
NAEOS_PH_APP_API_KEY=
NAEOS_PH_APP_API_SECRET=
# Co-maker invite link (from the PH dashboard, "Invite makers") — used in support-emails.md
NAEOS_PH_MAKER_INVITE_URL=
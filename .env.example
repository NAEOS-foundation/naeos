# Copy to .env (gitignored) and fill in. Never commit real secrets.
# All keys below are referenced by the NAEOS CLI/server, tools/discord-bot,
# scripts/*.sh, or .github/workflows/*.yml. Leave truly optional ones empty.
# IMPORTANT: always quote values containing spaces or shell metacharacters
# (&, ?, #, ;, $, quotes). An unquoted value with "&" silently becomes empty
# when the file is sourced, e.g.:
#   NAEOS_PH_LAUNCH_URL="https://www.producthunt.com/...?...&..."

# --- Supabase (internal/api, tools, CI Supabase Integration job) ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_ACCESS_TOKEN=
# Direct Postgres connection (used by local DB tooling)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# --- Cloudflare Workers / R2 (deploys, storage, site) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# NOTE: never paste curl headers into .env. Lines of the form
#   CF-Access-Client-Id:XXXX            # WRONG - key cannot contain ':'
#   CF-Access-Client-Secret:XXXX        # WRONG - leaks the credential into the key
# belong in a cf-curl invocation, not in environment files.

# --- Server / release bot (cmd/naeos, tools/discord-bot) ---
# Long random hex string used for auth token signing. Generate with: openssl rand -hex 32
NAEOS_ENCRYPTION_KEY=
NAEOS_REPO=
NAEOS_POLL_INTERVAL=15m
NAEOS_STATE_FILE=
NAEOS_ANNOUNCE_ON_STARTUP=true
NAEOS_BIN=
NAEOS_PH_LAUNCH_URL=
NAEOS_PH_TAGLINE=
NAEOS_PH_GALLERY_URL=
NAEOS_PH_RELEASE_NOTE=
GITHUB_TOKEN=

# --- Discord (tools/discord-bot, scripts/social-post.sh) ---
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_SERVER_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ANNOUNCE_CHANNEL=
# Discord app client secret; kept under the historical "SECCRET" spelling
# to match the existing GitHub Actions secret name
DISCORD_CLIENT_SECCRET=

# --- Slack (scripts/social-post.sh) ---
NAEOS_SLACK_TOKEN=
NAEOS_SLACK_ANNOUNCE_CHANNEL=

# --- LinkedIn (scripts/social-post.sh) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_URN=

# --- Product Hunt (scripts + support-emails.md) ---
# Register the app at https://www.producthunt.com/v2/oauth/applications
NAEOS_PH_REDIRECT_URI=
NAEOS_PH_APP_API_KEY=
NAEOS_PH_APP_API_SECRET=
# Co-maker invite link (from the PH dashboard, "Invite makers")
NAEOS_PH_MAKER_INVITE_URL=

# --- Optional (only used when using those features) ---
# LLM / AI feature (fallback chain: NAEOS_LLM_* -> provider-specific key)
NAEOS_LLM_PROVIDER=
NAEOS_LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# NAEOS DB connector defaults (omit for built-in defaults)
NAEOS_DB_DRIVER=
NAEOS_DB_DATABASE=

# --- Public endpoint consumed by deployed services ---
API_URL=
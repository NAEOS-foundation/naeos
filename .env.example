# Product Hunt app credentials — copy to .env (gitignored) and fill in.
# Register the app at https://www.producthunt.com/v2/oauth/applications
NAEOS_PH_REDIRECT_URI=
NAEOS_PH_APP_API_KEY=
NAEOS_PH_APP_API_SECRET=
# Co-maker invite link (from the PH dashboard, "Invite makers") — used in support-emails.md
NAEOS_PH_MAKER_INVITE_URL=

# --- Social posting (scripts/social-post.sh + .github/workflows/social-post.yml) ---
# Discord: bot token (https://discord.com/developers/applications) + channel id
DISCORD_TOKEN=
DISCORD_ANNOUNCE_CHANNEL=
# Slack: bot token (https://api.slack.com/apps) + channel id to post into
NAEOS_SLACK_TOKEN=
NAEOS_SLACK_ANNOUNCE_CHANNEL=
# LinkedIn organization posting: OAuth access token with w_organization_social + organization URN
# The authenticated member must have an authorized Page role. Keep the token in GitHub Actions secrets.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
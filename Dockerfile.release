# GoReleaser build context: contains only the compiled binary and this file.
FROM alpine:3.19@sha256:6baf43584bcb78f2e5847d1de515f23499913ac9f12bdf834811a3145eb11ca1

RUN apk --no-cache add ca-certificates git

WORKDIR /app

COPY naeos /usr/local/bin/naeos
COPY LICENSE NOTICE /usr/local/share/naeos/

RUN adduser -D -u 1000 naeos
USER naeos

HEALTHCHECK --interval=30s --timeout=5s CMD naeos health || exit 1

ENTRYPOINT ["naeos"]
CMD ["--help"]
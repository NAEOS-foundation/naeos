# NAEOS Discord Bot configuration example.
# Copy to .env and fill in your values, then: set -a; source .env; set +a
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional during testing so commands register instantly:
DISCORD_GUILD_ID=
# Channel that receives release + Product Hunt announcements:
DISCORD_ANNOUNCE_CHANNEL=

NAEOS_REPO=NAEOS-foundation/naeos
GITHUB_TOKEN=
NAEOS_POLL_INTERVAL=15m
NAEOS_STATE_FILE=.naeos-bot-state.json
NAEOS_ANNOUNCE_ON_STARTUP=true

NAEOS_PH_LAUNCH_URL=https://www.producthunt.com/posts/naeos
NAEOS_PH_TAGLINE=Specify Once. Build Anywhere.
NAEOS_PH_RELEASE_NOTE=v3.0.0 is live - pipeline profiling, stage caching, NEIR-aware LSP, distributed builds.

# Optional: path to a local naeos binary for /doctor (default: naeos in PATH)
# NAEOS_BIN=

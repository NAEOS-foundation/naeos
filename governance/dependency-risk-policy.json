{
  "policy_id": "dependency-risk-governance",
  "policy_version": "1.0.0",
  "schema_version": "1.0.0",
  "purpose": "Classify dependency changes by architectural criticality and verification evidence before merge.",
  "principle": "dependency change x architectural criticality x verification evidence",
  "versioning": {
    "patch": "candidate_low",
    "minor": "candidate_medium",
    "major": "candidate_high",
    "unknown": "unknown"
  },
  "critical_domains": ["policy", "security", "audit_evidence", "runtime", "deployment_ci"],
  "risk_matrix": [
    {"criticality": "low", "risk": "low", "required_gates": ["ci"], "decision": "allow"},
    {"criticality": "medium", "risk": "medium", "required_gates": ["ci", "governance"], "decision": "allow"},
    {"criticality": "high", "risk": "high", "required_gates": ["ci", "security", "governance", "human_review"], "decision": "require_review"},
    {"criticality": "critical", "risk": "critical", "required_gates": ["ci", "security", "benchmark", "governance", "human_review"], "decision": "require_review"},
    {"criticality": "unknown", "risk": "unknown", "required_gates": ["ci", "security", "governance", "human_review"], "decision": "deny"}
  ],
  "overrides": [
    {"condition": "dependency touches a critical domain", "minimum_criticality": "high"},
    {"condition": "required verification evidence is unavailable", "decision": "deny"},
    {"condition": "dependency change or impact cannot be classified", "decision": "deny"}
  ],
  "governance_flow": ["dependabot_proposal", "risk_classification", "verification", "human_review_if_required", "merge", "post_merge_verification"]
}

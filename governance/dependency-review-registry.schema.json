{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NAEOS-foundation/naeos/blob/main/governance/dependency-review-registry.schema.json",
  "title": "NAEOS Trusted Dependency Review Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "records"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "policy_version": { "type": "string", "minLength": 1 },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "https_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "version", "upstream_url", "spdx_license", "license_evidence_url", "checksum", "provenance_url", "purpose", "domains", "criticality", "reviewer", "review_reference", "reviewed_at", "review_expires_at"],
      "properties": {
        "ecosystem": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "upstream_url": { "$ref": "#/$defs/https_url" },
        "spdx_license": { "type": "string", "minLength": 1 },
        "license_evidence_url": { "$ref": "#/$defs/https_url" },
        "checksum": { "type": "string", "pattern": "^(sha256:[0-9a-fA-F]{64}|h1:[A-Za-z0-9+/]{43}=)$" },
        "provenance_url": { "$ref": "#/$defs/https_url" },
        "purpose": { "type": "string", "minLength": 1 },
        "domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["policy", "security", "audit_evidence", "runtime", "deployment_ci", "general"] } },
        "criticality": { "enum": ["low", "medium", "high", "critical"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "review_reference": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "review_expires_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

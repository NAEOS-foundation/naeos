FROM golang:1.26.10-alpine@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /naeos ./cmd/naeos/

FROM alpine:3.19@sha256:6baf43584bcb78f2e5847d1de515f23499913ac9f12bdf834811a3145eb11ca1

RUN apk --no-cache add ca-certificates git

WORKDIR /app

COPY --from=builder /naeos /usr/local/bin/naeos
COPY --from=builder /app/LICENSE /app/NOTICE /usr/local/share/naeos/
RUN mkdir -p /usr/local/share/licenses/naeos
COPY --from=builder /go/pkg/mod/github.com/!micah!parks/jwkset@v0.11.4/LICENSE /usr/local/share/licenses/naeos/jwkset-v0.11.4-LICENSE
COPY --from=builder /go/pkg/mod/github.com/!micah!parks/keyfunc/v3@v3.9.2/LICENSE /usr/local/share/licenses/naeos/keyfunc-v3.9.2-LICENSE
COPY --from=builder /go/pkg/mod/github.com/golang-jwt/jwt/v5@v5.3.1/LICENSE /usr/local/share/licenses/naeos/jwt-v5.3.1-LICENSE
COPY --from=builder /go/pkg/mod/golang.org/x/time@v0.15.0/LICENSE /usr/local/share/licenses/naeos/x-time-v0.15.0-LICENSE

RUN adduser -D -u 1000 -h /home/naeos naeos \
    && mkdir -p /home/naeos/.naeos/artifacts /home/naeos/.config/naeos \
    && chown -R naeos:naeos /home/naeos

ENV NAEOS_DB_DRIVER=sqlite \
    NAEOS_DB_DATABASE=/home/naeos/.naeos/naeos.db

WORKDIR /home/naeos
USER naeos

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/naeos"]
CMD ["api", "--port", "8080", "--auth", "--auth-mode", "supabase"]

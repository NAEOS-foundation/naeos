# Public assessment intake API
# Set this to the deployed NAEOS CRM API origin, for example:
# NEXT_PUBLIC_CRM_API_URL=https://<your-crm-api-host>
NEXT_PUBLIC_CRM_API_URL=

# Control Plane deployment API endpoint
# NEXT_PUBLIC_CONTROL_PLANE_API_URL=https://naeos-control-plane-production.up.railway.app

# Never configure API bearer tokens with NEXT_PUBLIC_* variables: Next.js exposes them to browsers.
# Production credentials must be held by a server-side proxy/secret store.

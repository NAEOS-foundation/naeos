{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "naeos",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "naeos.dev", "custom_domain": true },
    { "pattern": "www.naeos.dev", "custom_domain": true },
    { "pattern": "docs.naeos.dev", "custom_domain": true },
    { "pattern": "registry.naeos.dev", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "naeos"
    }
  ],
  "kv_namespaces": [],
  "previews": {}
}

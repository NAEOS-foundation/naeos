{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "naeos",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "naeos.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.naeos.dev",
      "custom_domain": true
    },
    {
      "pattern": "docs.naeos.dev",
      "custom_domain": true
    },
    {
      "pattern": "registry.naeos.dev",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "naeos"
    }
  ],
  "kv_namespaces": [],
  "previews": {},
  "env": {
    "staging": {
      "name": "naeos-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "NAEOS_ENVIRONMENT": "staging"
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "naeos-staging"
        }
      ],
      "kv_namespaces": []
    },
    "development": {
      "name": "naeos-development",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "NAEOS_ENVIRONMENT": "development"
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "naeos-development"
        }
      ],
      "kv_namespaces": []
    }
  }
}
